# ── Servidor ──
PORT=3000

# ── Base de datos ──
# Local: mongodb://localhost:27017/contrato21
# Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/contrato21
MONGO_URI=mongodb://localhost:27017/contrato21

# ── Autenticación ──
# Generar una clave larga y aleatoria para producción (ej: openssl rand -base64 32)
JWT_SECRET=cambia-esta-clave-en-produccion